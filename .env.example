# Supabase (프로젝트 생성 후 채우기). 비워두면 목업 데이터로 동작.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서비스 롤 키 (Supabase → Settings → API → service_role). 서버 전용, 절대 공개 금지.
# 관리자 콘솔(/admin)의 통계·회원·공고·매칭 조회와 기업/공고 등록·삭제가 전부 이 키로 동작한다.
# 없으면 /admin 전 화면이 0건으로만 보이므로 배포 환경(Vercel)에도 반드시 등록할 것.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (AI 보조 매칭 점수/사유). 비우면 규칙 기반 폴백 사유 사용.
ANTHROPIC_API_KEY=

# 알림 (v1: 카카오 알림톡 / 문자) — 공급사 키
KAKAO_ALIMTALK_API_KEY=
SMS_SENDER=
